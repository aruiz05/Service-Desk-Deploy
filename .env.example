# Optional production database connection.
# Leave unset for local development to use SQLite.
DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/database

# Optional production frontend origin for CORS.
FRONTEND_URL=https://your-frontend-domain.example

# Optional public demo protections.
# Keep false or unset for unrestricted local development.
DEMO_MODE=false
DEMO_MAX_EXTRA_TICKETS=25
DEMO_MAX_EXTRA_KNOWLEDGE_ARTICLES=10

# Optional single-admin authentication.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<generated-password-hash>
ADMIN_TOKEN_SECRET=<strong-random-secret>
ADMIN_TOKEN_EXPIRE_MINUTES=60
